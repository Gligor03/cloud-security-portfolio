# Public — safe to expose to the browser (prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_AUTHOR_NAME=Your Name
NEXT_PUBLIC_GITHUB_USERNAME=yourusername
NEXT_PUBLIC_GITHUB_URL=https://github.com/yourusername
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/yourprofile
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# Server-only — never commit real values

# Resend (https://resend.com) — contact form email delivery
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
# Must be a verified sender/domain in Resend; default uses onboarding address
RESEND_FROM=Portfolio <onboarding@resend.dev>
